# Copier ce fichier en .env et ajuster les valeurs.
# En production (Vercel), définir ces variables dans
# Settings > Environment Variables du projet.

SECRET_KEY=change-moi
FLASK_DEBUG=0
PORT=8000

# --- Base de données MySQL (obligatoire) -----------------------------
# Soit une URL complète :
DATABASE_URL=mysql://user:password@host:3306/kent
# ... soit les variables séparées (utilisées si DATABASE_URL est absente) :
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=kent
# SSL : par défaut activé sauf si l'hôte est localhost. Forcer avec :
# MYSQL_SSL=1   (ou 0 pour désactiver)

# --- Génération PDF -------------------------------------------------
# wkhtmltopdf : binaire système local (développement)
# http        : fonction serverless Node /api/render_pdf (Vercel)
PDF_ENGINE=wkhtmltopdf
WKHTMLTOPDF_BIN=wkhtmltopdf
# Base URL du service de rendu si PDF_ENGINE=http et qu'on ne veut pas
# utiliser VERCEL_URL (auto). Laisser vide sur Vercel.
PDF_RENDER_URL=
# Secret partagé entre l'app et la fonction Node (recommandé en prod).
PDF_RENDER_SECRET=

# --- Pièces jointes -------------------------------------------------
# Taille max d'un fichier joint (Mo). Doit rester <= max_allowed_packet
# du serveur MySQL.
MAX_UPLOAD_MB=8

# --- Initialisation de la base -------------------------------------
# Secret pour la route GET /admin/init?key=... (crée le schéma + les
# templates par défaut sans accès MySQL depuis votre poste). Laisser vide
# désactive la route (404).
SEED_SECRET=

# --- Coordonnées affichées sur l'OM et le BC ------------------------
COMPANY_NAME=Transports KENT
COMPANY_ADDRESS=14 Rue du Fer à Cheval
COMPANY_POSTAL_CODE=28200
COMPANY_CITY=ST-DENIS-LANNERAY
COMPANY_PHONE=07 44 90 60 38
COMPANY_SIRET=93073109600010
OM_LEGAL_REF=28/11/2011 Art1-1er-2
BC_LEGAL_REF=28/12/2011

# --- Email ---------------------------------------------------------
# "basic" (SMTP classique) ou "oauth2_o365" (Microsoft 365 / Exchange Online)
SMTP_AUTH_METHOD=basic
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM_NAME=Transports KENT
SMTP_FROM_EMAIL=votre-adresse@gmail.com

# Mode "oauth2_o365" (voir requirements-optional.txt) :
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_SENDER_EMAIL=

# Libellés proposés quand on choisit le véhicule "(pause)" sur une ligne
# de trajet du formulaire d'ordre de mission. Séparés par des "|" (et non
# des virgules : un libellé peut en contenir une). Le champ reste libre.
# Vide = aucune proposition, saisie entièrement à la main.
PAUSE_LABELS=Pause + Attente Clients|Pause 15 min|Pause 30 min

# --- Estimation des durées de trajet --------------------------------
# Chaque ligne de trajet du formulaire de mission propose 2 boutons
# "Estimer" (durée avec trafic à l'heure de départ) : un par fournisseur.

# TomTom (inscription libre sur developer.tomtom.com, 2 500 requêtes/jour
# gratuites), appelé côté serveur (la clé n'apparaît jamais dans le
# navigateur). Alimente le bouton "Estimer TomTom" du formulaire OM et, sur
# l'écran Plan de Ramassage, le choix "Itinéraires : TomTom" (à la place de
# Google Maps) pour les trajets comme pour les navettes. Sans clé, ce choix
# est grisé et le reste de l'application fonctionne normalement.
TOMTOM_API_KEY=

# Google Maps JavaScript API (console.cloud.google.com), avec les API
# "Places API", "Distance Matrix API" et "Directions API" activées côté
# projet Google Cloud. Alimente le bouton "Estimer avec Maps", l'écran Plan
# de Ramassage (carte, itinéraire le plus court, distances par la route) ET,
# si le réglage "Recherche d'adresse" (écran Réglages) est sur Google,
# l'autocomplétion d'adresse des arrêts. Sans clé, cet écran calcule
# quand même l'ordre de passage (côté serveur, à vol d'oiseau) mais n'affiche
# pas de carte. Contrairement à TOMTOM_API_KEY, cette clé est utilisée côté
# navigateur : c'est le fonctionnement normal d'une clé "Maps JavaScript
# API", à restreindre par "référents HTTP" (votre domaine) dans la console
# Google Cloud plutôt que de la garder secrète. NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# est acceptée comme alias du même réglage.
GOOGLE_MAPS_API_KEY=

# Client remonté en tête du menu déroulant "Client" du formulaire de mission.
PINNED_CLIENT_NAME=Simplon Voyages

# --- Authentification -------------------------------------------------
# Les seuls comptes sont des fiches chauffeur : dans l'écran Personnel,
# cocher « Autoriser ce chauffeur à se connecter » puis saisir un
# identifiant et un mot de passe. Sans la case « Administrateur », il est en
# lecture seule sur son planning et ses propres ordres de mission ; avec,
# il a accès à tout. Un chauffeur sans accès reçoit seulement ses ordres de
# mission par email. Il n'y a pas d'autre type d'utilisateur.

# Secret de signature des jetons JWT. Laisser vide réutilise SECRET_KEY.
# Le changer déconnecte immédiatement tout le monde.
JWT_SECRET=

# Durée de validité d'une session, en heures (168 = 7 jours).
JWT_TTL_HOURS=168

# Compte amorcé automatiquement (administrateur) si AUCUN chauffeur ne
# peut se connecter
# (premier démarrage, ou accès retiré à tout le monde). La fiche est créée
# si elle n'existe pas. ⚠️ Changez BOOTSTRAP_PASSWORD, ou le mot de passe
# depuis la fiche chauffeur dès la première connexion.
BOOTSTRAP_LAST_NAME=KILINC
BOOTSTRAP_FIRST_NAME=Ismail
BOOTSTRAP_EMAIL=
BOOTSTRAP_USERNAME=ikilinc
BOOTSTRAP_PASSWORD=

# --- Planning / partage calendrier -----------------------------------
# Secret du flux iCalendar (abonnement dans Calendrier iPhone / Google
# Agenda). Générer une valeur aléatoire, ex. avec `python -c "import
# secrets; print(secrets.token_urlsafe(24))"`. Laisser vide désactive le
# partage (le bouton "Partager" de l'écran Planning affichera comment
# l'activer).
CALENDAR_FEED_TOKEN=
